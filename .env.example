# Copy to .env and adjust: cp .env.example .env

# Database password (any long random string; Compose passes it separately to the API).
POSTGRES_PASSWORD=zmente-me-na-dlouhe-nahodne-heslo

# First start only: organization and first administrator.
# Without ADMIN_PASSWORD a random one is generated and printed in `docker compose logs api`.
ORG_NAME=Revizní firma
ADMIN_EMAIL=admin@revize.local
ADMIN_PASSWORD=

# Fill an empty database with demo data (customer, Žebřík/Regál, 30 items) – prototype only.
SEED_DEMO=true

# Address the server is reached at; decides how Caddy gets the HTTPS certificate.
# localhost | <stroj>.<tailnet>.ts.net | <jmeno>.duckdns.org | :80 (behind a tunnel)
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Only for plain-HTTP setups (SITE_ADDRESS=:80 without a TLS tunnel): false.
COOKIE_SECURE=true

# Resource limits (CPU and RAM) – optional, defaults shown below:
# DB_CPU_LIMIT=1.0
# DB_MEMORY_LIMIT=512M
# API_CPU_LIMIT=2.0
# API_MEMORY_LIMIT=1G
# WEB_CPU_LIMIT=1.0
# WEB_MEMORY_LIMIT=256M

# Storage limits – optional:
# STORAGE_MAX_GB=10
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3
